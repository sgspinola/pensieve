# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright (e2e)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/e2e/.auth/

# next.js
/.next/
/out/
/logs/

# vitepress
/docs/.vitepress/dist
/docs/.vitepress/cache

# production
/build

# misc
.DS_Store
*.pem
TODO.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# python (unrelated local venv)
.venv

# claude code local/runtime files
.claude/settings.local.json
.claude/scheduled_tasks.lock

# typescript
*.tsbuildinfo
next-env.d.ts

# local-only tooling output
/graphify-out/
.claude/worktrees/
